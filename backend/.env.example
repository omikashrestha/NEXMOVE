# NEXMOVE Backend Environment Configuration (Render / Local)

# Database Connection
# Default: Local SQLite file. Note: On Render Free tier, local SQLite files reset upon container restarts/redeploys.
DATABASE_URL=sqlite:///./nexmove.db

# Environment
APP_ENV=development
DEBUG=True

# Currency Settings
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹

# Benchmarks Data Path (Relative to repository root)
BENCHMARKS_DIR=data/sample_benchmarks

# CORS Configuration
# Comma-separated list of exact allowed origin URLs (e.g. your production Vercel domain)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nexmove.vercel.app

# Optional project-scoped CORS regex for Vercel preview branch deployments
ALLOWED_ORIGIN_REGEX=^https://nexmove(-[a-z0-9-]+)?\.vercel\.app$
